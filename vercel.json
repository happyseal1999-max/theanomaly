{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "HUSKY=0 npx -y pnpm@11.21.0 install --frozen-lockfile",
  "buildCommand": "cd frontend && npx -y pnpm@11.21.0 exec vite build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:page(test|settings|account|about|login|profile|friends|account-settings|leaderboards)",
      "destination": "/index.html"
    },
    {
      "source": "/:page(test|settings|account|about|login|profile|friends|account-settings|leaderboards)/:rest*",
      "destination": "/index.html"
    },
    { "source": "/verify", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|gif|png|svg|eot|otf|ttf|ttc|woff|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "max-age=31536000" }]
    },
    {
      "source": "/(.*)\\.(json|wav|txt|css)",
      "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
    },
    {
      "source": "/:dir(js|css)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "max-age=31536000" }]
    },
    {
      "source": "/:file(version.json|sw.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
